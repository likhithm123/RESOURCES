# Copy to .env.local for local development. Add the same keys in Vercel -> Project -> Settings -> Environment Variables.
APP_NAME=Resources Portal
SESSION_SECRET=                      # long random string: openssl rand -hex 32
ADMIN_EMAILS=                        # comma-separated emails that become admins when they sign in

# Cloudflare D1 over HTTP (tables are prefixed rp_)
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=                        # API token with D1 Edit permission

# ImageKit (private page images of the notes)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_FOLDER=/resources-portal

# SMTP (sign-in codes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=                           # Gmail: an App Password, not your normal password
