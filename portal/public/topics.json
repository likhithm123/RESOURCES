[{"key":"01-upsc-exam-roadmap-and-strategy","no":1,"title":"UPSC From Zero to IAS - Exam, Roadmap and Strategy","intro":"Start here. This notebook explains what the Civil Services Examination (CSE) is, who can write it, how marks work, what to read, and how a Class 12 student or graduate should plan each year. Read it fully once before opening any subject notebook.","topics":[{"id":"01-what-is-upsc-and-the-civil-services-examination","title":"What is UPSC and the Civil Services Examination","subs":[]},{"id":"01-eligibility","title":"Eligibility","subs":[]},{"id":"01-stage-1-preliminary-examination","title":"Stage 1 - Preliminary Examination","subs":["GS Paper I syllabus","Problem with answer - calculating a Prelims score"]},{"id":"01-stage-2-main-examination","title":"Stage 2 - Main Examination","subs":["Where the marks come from - a realistic target"]},{"id":"01-stage-3-personality-test","title":"Stage 3 - Personality Test","subs":[]},{"id":"01-service-and-cadre-allocation","title":"Service and Cadre Allocation","subs":[]},{"id":"01-how-questions-are-really-asked","title":"How Questions Are Really Asked","subs":[]},{"id":"01-the-four-level-learning-method-used-in-these-notes","title":"The Four-Level Learning Method Used in These Notes","subs":[]},{"id":"01-year-wise-roadmap","title":"Year-wise Roadmap","subs":["A one-year plan for a graduate starting from zero"]},{"id":"01-daily-and-weekly-system","title":"Daily and Weekly System","subs":[]},{"id":"01-booklist-buy-step-by-step","title":"Booklist (Buy Step by Step)","subs":[]},{"id":"01-common-mistakes-of-beginners","title":"Common Mistakes of Beginners","subs":[]},{"id":"01-important-questions-and-answers","title":"Important Questions and Answers","subs":[]},{"id":"01-chapter-test","title":"Chapter Test","subs":[]}]},{"key":"02-ancient-and-medieval-india","no":2,"title":"History I - Ancient and Medieval India","intro":"History is not a list of kings. It is the story of how people lived, produced food, organised power and expressed belief. For every period ask five questions: Polity, Economy, Society, Religion, Art. (Mnemonic: PESRA.)","topics":[{"id":"02-sources-of-history","title":"Sources of History","subs":[]},{"id":"02-prehistoric-india","title":"Prehistoric India","subs":[]},{"id":"02-indus-valley-harappan-civilisation","title":"Indus Valley (Harappan) Civilisation","subs":[]},{"id":"02-vedic-age","title":"Vedic Age","subs":[]},{"id":"02-mahajanapadas-and-rise-of-magadha","title":"Mahajanapadas and Rise of Magadha","subs":[]},{"id":"02-buddhism-and-jainism","title":"Buddhism and Jainism","subs":[]},{"id":"02-mauryan-empire-321-185-bce","title":"Mauryan Empire (321-185 BCE)","subs":[]},{"id":"02-post-mauryan-period","title":"Post-Mauryan Period","subs":[]},{"id":"02-sangam-age-south-india","title":"Sangam Age (South India)","subs":[]},{"id":"02-gupta-empire-c-319-550-ce","title":"Gupta Empire (c. 319-550 CE)","subs":[]},{"id":"02-post-gupta-and-early-medieval-kingdoms","title":"Post-Gupta and Early Medieval Kingdoms","subs":["Imperial Cholas (9th-13th century)"]},{"id":"02-medieval-india-delhi-sultanate-1206-1526","title":"Medieval India - Delhi Sultanate (1206-1526)","subs":[]},{"id":"02-vijayanagara-and-bahmani-kingdoms","title":"Vijayanagara and Bahmani Kingdoms","subs":[]},{"id":"02-mughal-empire","title":"Mughal Empire","subs":[]},{"id":"02-marathas-and-sikhs","title":"Marathas and Sikhs","subs":[]},{"id":"02-bhakti-and-sufi-movements","title":"Bhakti and Sufi Movements","subs":[]},{"id":"02-timeline-to-memorise","title":"Timeline to Memorise","subs":[]},{"id":"02-common-misconceptions","title":"Common Misconceptions","subs":[]},{"id":"02-prelims-mcqs-with-explanations","title":"Prelims MCQs with Explanations","subs":[]},{"id":"02-mains-questions-with-model-structures","title":"Mains Questions with Model Structures","subs":[]},{"id":"02-revision-sheet","title":"Revision Sheet","subs":[]}]},{"key":"03-modern-india-and-post-independence","no":3,"title":"History II - Modern India and Post-Independence","intro":"Modern History gives 12-18 Prelims questions and a full section in GS I. Learn it as one story: Europeans come to trade -> the Company conquers -> the economy is drained -> Indians resist -> a mass national movement wins freedom -> the new nation is built.","topics":[{"id":"03-arrival-of-europeans","title":"Arrival of Europeans","subs":[]},{"id":"03-british-conquest-of-india","title":"British Conquest of India","subs":[]},{"id":"03-constitutional-development-under-the-british","title":"Constitutional Development under the British","subs":[]},{"id":"03-economic-impact-of-british-rule","title":"Economic Impact of British Rule","subs":[]},{"id":"03-resistance-before-1857-and-the-revolt-of-1857","title":"Resistance before 1857 and the Revolt of 1857","subs":[]},{"id":"03-socio-religious-reform-movements","title":"Socio-Religious Reform Movements","subs":[]},{"id":"03-indian-national-movement-three-phases","title":"Indian National Movement - Three Phases","subs":["Moderate phase (1885-1905)","Extremist phase and Swadeshi","Gandhian era","Why Gandhi's methods worked"]},{"id":"03-post-independence-india","title":"Post-Independence India","subs":["Integration of princely states","Reorganisation of states","Nation building"]},{"id":"03-important-personalities-and-books","title":"Important Personalities and Books","subs":[]},{"id":"03-prelims-mcqs-with-explanations","title":"Prelims MCQs with Explanations","subs":[]},{"id":"03-mains-questions-with-model-structures","title":"Mains Questions with Model Structures","subs":[]},{"id":"03-revision-sheet","title":"Revision Sheet","subs":[]}]},{"key":"04-world-history-and-art-culture","no":4,"title":"History III - World History and Indian Art and Culture","intro":"World History is only in Mains GS I (1-2 questions). Art and Culture gives 4-8 Prelims questions and 1-2 Mains questions. Both reward clear concepts and a few precise examples.","topics":[{"id":"04-renaissance-reformation-and-enlig