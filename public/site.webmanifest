  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Daily Streak & Track Sheet",
      "short_name": "Streak",
      "description": "View active daily study streak and update progress",
      "url": "/?streak=open",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Android Widget Card",
      "short_name": "Widget",
      "description": "Open live compact Android home screen streak widget",
      "url": "/widget",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Curriculum Notes",
      "short_name": "Notes",
      "description": "Study comprehensive handwritten curriculum notebooks",
      "url": "/library",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
